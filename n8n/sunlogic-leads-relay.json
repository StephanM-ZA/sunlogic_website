        "jsCode": "/* The Worker sends one shape now. Everything downstream reads these\n   fields, so normalise once and never guess again. */\nreturn $input.all().map((item) => {\n  const b = item.json.body || item.json;\n  return { json: {\n    event: b.event || 'offer',\n    leadId: b.leadId ?? '',\n    needsSend: b.needsSend !== false,\n    to: Array.isArray(b.to) ? b.to.join(', ') : (b.to || ''),\n    replyTo: b.replyTo || '',\n    subject: b.subject || 'Sunlogic',\n    html: b.html || '',\n    type: b.type || '',\n    name: b.name || '', email: b.email || '', phone: b.phone || '',\n    need: b.need || '', division: b.divisionLabel || b.division || '',\n    assignee: b.assignee || '', status: b.status || b.event || '',\n    raw: b.raw || JSON.stringify(b),\n  } };\n});"
      },
