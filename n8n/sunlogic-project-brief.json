    {
      "parameters": {
        "jsCode": "const r = $('PostgreSQL Insert').first().json;\n// every uploaded photo is a leads-relay URL; the first of each field lands in\n// its own column and the rest are appended as text to the comments\nconst re = /https:\\/\\/leads\\.sunlogic\\.co\\.za\\/uploads\\/[^\\s\"'<>)]+/g;\nconst seen = new Set();\nconst photos = [];\nfor (const src of [r.upload_photos_db, r.upload_photos, r.comments_instructions]) {\n  if (!src) continue;\n  for (const hit of String(src).match(re) || []) {\n    const url = hit.replace(/[.,;:]+$/, '');\n    if (seen.has(url)) continue;\n    seen.add(url);\n    photos.push({ url, name: decodeURIComponent(url.split('/').pop()) });\n  }\n}\nreturn [{ json: { photos, photoCount: photos.length } }];\n"
      },
