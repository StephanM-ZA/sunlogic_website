    {
      "parameters": {
        "html": "<!DOCTYPE html>\n\n<html>\n<head>\n  <meta charset=\"UTF-8\" />\n</head>\n<body>\n  <div class=\"container\">\n    <h1>Project Brief</h1>\n    <h2></h2>\n    <p>Good day, a new Project Brief has been submitted by:\n{{ $('PostgreSQL Insert').item.json.project_brief_submitted_by }}. <br></br>\n    Below are the details of that project:<br>\n<br>\n<strong>Job Category:</strong> {{ $('PostgreSQL Insert').item.json.job_category }}<br>\n<strong>Business or Personal:</strong> {{ $('PostgreSQL Insert').item.json.business_or_personal }}<br>\n<strong>Quote/Invoice Nr:</strong> {{ $('PostgreSQL Insert').item.json.quote_invoice_number }}<br>\n<strong>Business Name:</strong> {{ $('PostgreSQL Insert').item.json.business_name }}<br>\n<strong>Client Name:</strong> {{ $('PostgreSQL Insert').item.json.client_name }}<br>\n<strong>Client Surname:</strong> {{ $('PostgreSQL Insert').item.json.client_surname }}<br>\n<strong>Client Email:</strong> {{ $('PostgreSQL Insert').item.json.client_email }}<br>\n<strong>Client Contact:</strong> {{ $('PostgreSQL Insert').item.json.client_contact_number }}<br>\n<strong>Street Address:</strong> {{ $('PostgreSQL Insert').item.json.street_address }}<br>\n<strong>GPS Location:</strong> {{ $('PostgreSQL Insert').item.json.gps_location }}<br>\n<strong>Google Maps:</strong> {{ $('PostgreSQL Insert').item.json.google_maps_link }}<br>\n<br>\n<strong>Proposed Date:</strong> {{ $('PostgreSQL Insert').item.json.proposed_date }}<br>\n<br>\n<strong>Type:</strong> {{ $('PostgreSQL Insert').item.json.type }}<br>\n<strong>Building Type:</strong> {{ $('PostgreSQL Insert').item.json.building_type }}<br>\n<strong>Roof Type:</strong> {{ $('PostgreSQL Insert').item.json.roof_type }}<br>\n<strong>Height of Building:</strong> {{ $('PostgreSQL Insert').item.json.height_of_building }}<br>\n<strong>Roof Size:</strong> {{ $('PostgreSQL Insert').item.json.roof_size }}<br>\n<strong>Type of Electrical Work:</strong> {{ $('PostgreSQL Insert').item.json.type_of_electrical_work }}<br>\n<strong>Phases:</strong> {{ $('PostgreSQL Insert').item.json.phases }}<br>\n<br>\nPlease note the following instructions!!<br>\n{{ $('PostgreSQL Insert').item.json.comments_instructions }}<br>\n<br>\nSupporting doc's can be found here:<br>\n{{ $('PostgreSQL Insert').item.json.upload_photos_db }}<br>\n{{ $('PostgreSQL Insert').item.json.upload_photos }}<br>\n<br>\nPlease go have a look at the Trello card to proceed with the job.<br>\n</p>\n  </div>\n</body>\n</html>\n\n<style>\n.container {\n  text-align: left;\n  padding: 16px;\n  border-radius: 8px;\n}\n\nh1 {\n  color: #ff8000;\n  font-size: 18px;\n  font-weight: bold;\n  padding: 0px;\n}\n\nh2 {\n  color: #909399;\n  font-size: 18px;\n  font-weight: bold;\n  padding: 0px;\n}\n</style>"
      },
