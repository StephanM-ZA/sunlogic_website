# OS / editor junk
.DS_Store
Thumbs.db
*.swp
*~

# Environment / secrets (never commit real values)
.env
.env.local
.env.*.local

# Editor directories
.vscode/
.idea/

# Subagent-driven-development scratch workspace (ledgers, briefs, reports)
.superpowers/

# Node deps (playwright, used for local screenshot checks only)
node_modules/

# Wrangler local build/dev cache (Cloudflare Worker tooling)
.wrangler/

# Build output — minified copy of site-daylight/, generated by
# scripts/build-site.js and published by the deploy workflow. Never
# committed; source stays hand-readable under site-daylight/.
/dist/

# Lighthouse CI report output (npm run lighthouse) — local/CI scratch,
# uploaded as a workflow artifact instead of committed.
/.lighthouseci/

# Design reference bundles — kept on disk under design-inspiration/, out of
# git. Tens of MB of screenshots and PDFs; none of it governs the live site
# (site-daylight/SYSTEM.md does). These were untracked before the tidy-up.
design-inspiration/godaylight-design/
design-inspiration/design_handoff_sunlogic_blend/
design-inspiration/design-system/

# Original high-resolution image sources (iStock etc). Kept on disk, out of
# git, and OUT of any site-*/ directory: scripts/build-site.js converts every
# .jpg it finds in a site tree to webp and ships it, so an 18MB original left
# in site-energy/images/ would be published as a converted asset nobody asks
# for. Compressed, correctly-sized variants are committed instead.
design-inspiration/source-images/
