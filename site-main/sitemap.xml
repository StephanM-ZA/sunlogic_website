<?xml version="1.0" encoding="UTF-8"?>
<!-- The apex. Since the site split into three this is a router: it describes
     the company and sends you to whichever division you need, so the only
     pages it still owns are the home page, contact and legal.

     Solar, electrical, energy management and the blog moved to
     energy.sunlogic.co.za and electrical.sunlogic.co.za and are listed in
     those sites' own sitemaps. The apex 301s the old URLs there — see
     _redirects — so they are deliberately absent here rather than listed as
     redirects, which is what a sitemap should never contain.

     ci-guide.html is excluded — internal corporate identity document, and
     robots.txt disallows it.
     thank-you.html and 404.html are excluded — a post-submit destination and
     an error page are not entry points. -->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://sunlogic.co.za/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://sunlogic.co.za/contact.html</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://sunlogic.co.za/legal.html</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
</urlset>
